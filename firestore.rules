rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/conferences/{conferenceId} {
      function ownsDocument() {
        return request.auth != null && request.auth.uid == userId;
      }

      function validRankingState() {
        return request.resource.data.keys().hasOnly([
                 'schema_version', 'conference_id', 'state', 'updated_at'
               ])
               && request.resource.data.schema_version == 1
               && request.resource.data.conference_id == conferenceId
               && request.resource.data.state is map;
      }

      allow read, delete: if ownsDocument();
      allow create, update: if ownsDocument() && validRankingState();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
